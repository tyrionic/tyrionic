# Target-neutral direct Native IR lowering. This module is deliberately
# separate from native_ir_source.ty: the latter remains the explicit v1
# static-program oracle until the direct route passes the migration gates.

def native_direct_function_names(program):
    names = []
    idx = 0
    while idx < len(program["items"]):
        statement = program["items"][idx]
        if statement["kind"] == "function":
            names = method_append(names, statement["name"])
        elif statement["kind"] == "class":
            names = method_append(names, statement["name"])
            member_idx = 0
            while member_idx < len(statement["body"]):
                member = statement["body"][member_idx]
                if member["kind"] == "function":
                    names = method_append(names, "@method:" + member["name"])
                member_idx = member_idx + 1
        elif statement["kind"] == "assign" and statement["target"]["kind"] == "var" and statement["value"]["kind"] == "lambda":
            names = method_append(names, statement["target"]["value"])
        idx = idx + 1
    return names


def native_direct_analyze(program, target):
    target = backend_require_operation(target, "native-ir-v2-direct")
    application = require_application_analysis(program, native_direct_function_names(program))
    return {"contract": "tyrion-native-direct-analysis-v1", "target": target, "program": program, "application": application}


def native_direct_append_local(locals, name):
    found = False
    local_idx = 0
    while local_idx < len(locals):
        if locals[local_idx]["name"] == name:
            found = True
        local_idx = local_idx + 1
    if not found:
        locals = method_append(locals, {"id": len(locals), "name": name, "kind": "value_slot"})
    return locals


def native_direct_collect_statement_locals(items, locals):
    idx = 0
    while idx < len(items):
        statement = items[idx]
        if statement["kind"] == "assign" and statement["target"]["kind"] == "var":
            locals = native_direct_append_local(locals, statement["target"]["value"])
        elif statement["kind"] == "assign" and statement["target"]["kind"] == "unpack":
            target_idx = 0
            while target_idx < len(statement["target"]["targets"]):
                locals = native_direct_append_local(locals, statement["target"]["targets"][target_idx]["name"])
                target_idx = target_idx + 1
        elif statement["kind"] == "if":
            locals = native_direct_collect_statement_locals(statement["body"], locals)
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                locals = native_direct_collect_statement_locals(statement["elifs"][branch_idx]["body"], locals)
                branch_idx = branch_idx + 1
            locals = native_direct_collect_statement_locals(statement["else_body"], locals)
        elif statement["kind"] == "while":
            locals = native_direct_collect_statement_locals(statement["body"], locals)
        elif statement["kind"] == "for":
            target_idx = 0
            while target_idx < len(statement["targets"]):
                locals = native_direct_append_local(locals, statement["targets"][target_idx])
                target_idx = target_idx + 1
            locals = native_direct_collect_statement_locals(statement["body"], locals)
        idx = idx + 1
    return locals


def native_direct_collect_locals(program):
    return native_direct_collect_statement_locals(program["items"], [])


def native_direct_append_unique_name(names, name):
    idx = 0
    while idx < len(names):
        if names[idx] == name:
            return names
        idx = idx + 1
    return method_append(names, name)


def native_direct_collect_aggregate_names(items, names):
    idx = 0
    while idx < len(items):
        statement = items[idx]
        if statement["kind"] == "assign" and statement["target"]["kind"] == "var":
            value = statement["value"]
            if value["kind"] == "list" or value["kind"] == "tuple" or value["kind"] == "set" or value["kind"] == "dict":
                names = native_direct_append_unique_name(names, statement["target"]["value"])
            elif value["kind"] == "var":
                source_idx = 0
                while source_idx < len(names):
                    if names[source_idx] == value["value"]:
                        names = native_direct_append_unique_name(names, statement["target"]["value"])
                    source_idx = source_idx + 1
        elif statement["kind"] == "if":
            names = native_direct_collect_aggregate_names(statement["body"], names)
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                names = native_direct_collect_aggregate_names(statement["elifs"][branch_idx]["body"], names)
                branch_idx = branch_idx + 1
            names = native_direct_collect_aggregate_names(statement["else_body"], names)
        elif statement["kind"] == "for":
            iterable = statement["iterable"]
            if iterable["kind"] == "var" and native_direct_name_in_list(names, iterable["value"]):
                target_idx = 0
                while target_idx < len(statement["targets"]):
                    names = native_direct_append_unique_name(names, statement["targets"][target_idx])
                    target_idx = target_idx + 1
            elif iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "enumerate" and len(iterable["args"]) > 0:
                inner = iterable["args"][0]
                if inner["kind"] == "var" and native_direct_name_in_list(names, inner["value"]):
                    target_idx = 0
                    while target_idx < len(statement["targets"]):
                        names = native_direct_append_unique_name(names, statement["targets"][target_idx])
                        target_idx = target_idx + 1
            elif iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "zip":
                target_idx = 0
                while target_idx < len(statement["targets"]):
                    names = native_direct_append_unique_name(names, statement["targets"][target_idx])
                    target_idx = target_idx + 1
            names = native_direct_collect_aggregate_names(statement["body"], names)
        elif statement["kind"] == "while":
            names = native_direct_collect_aggregate_names(statement["body"], names)
        idx = idx + 1
    return names


def native_direct_aggregate_names(program):
    names = []
    changed = True
    while changed:
        prior_count = len(names)
        names = native_direct_collect_aggregate_names(program["items"], names)
        changed = len(names) != prior_count
    return names


def native_direct_collect_string_names(items, names):
    idx = 0
    while idx < len(items):
        statement = items[idx]
        if statement["kind"] == "assign" and statement["target"]["kind"] == "var":
            value = statement["value"]
            if value["kind"] == "string":
                names = native_direct_append_unique_name(names, statement["target"]["value"])
            elif value["kind"] == "var" and native_direct_name_in_list(names, value["value"]):
                names = native_direct_append_unique_name(names, statement["target"]["value"])
        elif statement["kind"] == "if":
            names = native_direct_collect_string_names(statement["body"], names)
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                names = native_direct_collect_string_names(statement["elifs"][branch_idx]["body"], names)
                branch_idx = branch_idx + 1
            names = native_direct_collect_string_names(statement["else_body"], names)
        elif statement["kind"] == "for":
            iterable = statement["iterable"]
            if iterable["kind"] == "var" and native_direct_name_in_list(names, iterable["value"]) and len(statement["targets"]) == 1:
                names = native_direct_append_unique_name(names, statement["targets"][0])
            elif iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "enumerate" and len(iterable["args"]) > 0 and len(statement["targets"]) == 2:
                inner = iterable["args"][0]
                if inner["kind"] == "var" and native_direct_name_in_list(names, inner["value"]):
                    names = native_direct_append_unique_name(names, statement["targets"][1])
            names = native_direct_collect_string_names(statement["body"], names)
        elif statement["kind"] == "while":
            names = native_direct_collect_string_names(statement["body"], names)
        idx = idx + 1
    return names


def native_direct_string_names(program):
    names = []
    changed = True
    while changed:
        prior_count = len(names)
        names = native_direct_collect_string_names(program["items"], names)
        changed = len(names) != prior_count
    return names


def native_direct_for_control_slot_count(statement):
    iterable = statement["iterable"]
    if iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "enumerate":
        if len(iterable["args"]) > 0:
            inner = iterable["args"][0]
            if inner["kind"] == "list" or inner["kind"] == "tuple":
                return 2 + len(inner["items"])
            if inner["kind"] == "var":
                return 3
        return 2
    if iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "zip":
        return len(iterable["args"]) + 1
    if iterable["kind"] == "list" or iterable["kind"] == "tuple":
        return 1 + len(iterable["items"])
    if iterable["kind"] == "var":
        return 2
    return 1


def native_direct_count_for_control_slots(items):
    count = 0
    idx = 0
    while idx < len(items):
        statement = items[idx]
        if statement["kind"] == "if":
            count = count + native_direct_count_for_control_slots(statement["body"])
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                count = count + native_direct_count_for_control_slots(statement["elifs"][branch_idx]["body"])
                branch_idx = branch_idx + 1
            count = count + native_direct_count_for_control_slots(statement["else_body"])
        elif statement["kind"] == "while":
            count = count + native_direct_count_for_control_slots(statement["body"])
        elif statement["kind"] == "for":
            count = count + native_direct_for_control_slot_count(statement) + native_direct_count_for_control_slots(statement["body"])
        idx = idx + 1
    return count


def native_direct_expression_temporary_depth(expression):
    kind = expression["kind"]
    if kind == "list" or kind == "tuple" or kind == "set":
        depth = 1
        item_idx = 0
        while item_idx < len(expression["items"]):
            item_depth = 1 + native_direct_expression_temporary_depth(expression["items"][item_idx])
            if item_depth > depth:
                depth = item_depth
            item_idx = item_idx + 1
        return depth
    if kind == "dict":
        depth = 1
        entry_idx = 0
        while entry_idx < len(expression["entries"]):
            key_depth = 1 + native_direct_expression_temporary_depth(expression["entries"][entry_idx]["key"])
            value_depth = 1 + native_direct_expression_temporary_depth(expression["entries"][entry_idx]["value"])
            if key_depth > depth:
                depth = key_depth
            if value_depth > depth:
                depth = value_depth
            entry_idx = entry_idx + 1
        return depth
    if kind == "call":
        depth = 1
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            argument = expression["args"][arg_idx]
            if argument["kind"] == "kwarg":
                argument = argument["value"]
            argument_depth = 1 + native_direct_expression_temporary_depth(argument)
            if argument_depth > depth:
                depth = argument_depth
            arg_idx = arg_idx + 1
        return depth
    if kind == "method_call":
        depth = 1 + native_direct_expression_temporary_depth(expression["receiver"])
        arg_idx = 0
        while arg_idx < len(expression["args"]):
            argument = expression["args"][arg_idx]
            if argument["kind"] == "kwarg":
                argument = argument["value"]
            argument_depth = 1 + native_direct_expression_temporary_depth(argument)
            if argument_depth > depth:
                depth = argument_depth
            arg_idx = arg_idx + 1
        return depth
    if kind == "binary":
        left_depth = 1 + native_direct_expression_temporary_depth(expression["left"])
        right_depth = 1 + native_direct_expression_temporary_depth(expression["right"])
        if left_depth > right_depth:
            return left_depth
        return right_depth
    if kind == "unary":
        return 1 + native_direct_expression_temporary_depth(expression["value"])
    if kind == "index":
        receiver_depth = 1 + native_direct_expression_temporary_depth(expression["receiver"])
        index_depth = 1 + native_direct_expression_temporary_depth(expression["index"])
        if receiver_depth > index_depth:
            return receiver_depth
        return index_depth
    if kind == "slice":
        depth = 1 + native_direct_expression_temporary_depth(expression["receiver"])
        start_depth = 1 + native_direct_expression_temporary_depth(expression["start"])
        stop_depth = 1 + native_direct_expression_temporary_depth(expression["stop"])
        if start_depth > depth:
            depth = start_depth
        if stop_depth > depth:
            depth = stop_depth
        return depth
    return 0


def native_direct_statement_temporary_depth(items):
    depth = 0
    idx = 0
    while idx < len(items):
        statement = items[idx]
        if statement["kind"] == "assign":
            statement_depth = native_direct_expression_temporary_depth(statement["value"])
            if statement["target"]["kind"] == "index":
                statement_depth = statement_depth + 1
            elif statement["target"]["kind"] == "unpack":
                statement_depth = statement_depth + 1
            if statement_depth > depth:
                depth = statement_depth
            if statement["target"]["kind"] == "index":
                statement_depth = 1 + native_direct_expression_temporary_depth(statement["target"]["receiver"])
                if statement_depth > depth:
                    depth = statement_depth
                statement_depth = 1 + native_direct_expression_temporary_depth(statement["target"]["index"])
                if statement_depth > depth:
                    depth = statement_depth
        elif statement["kind"] == "if":
            statement_depth = 1 + native_direct_expression_temporary_depth(statement["condition"])
            if statement_depth > depth:
                depth = statement_depth
            statement_depth = native_direct_statement_temporary_depth(statement["body"])
            if statement_depth > depth:
                depth = statement_depth
            branch_idx = 0
            while branch_idx < len(statement["elifs"]):
                statement_depth = native_direct_statement_temporary_depth(statement["elifs"][branch_idx]["body"])
                if statement_depth > depth:
                    depth = statement_depth
                branch_idx = branch_idx + 1
            statement_depth = native_direct_statement_temporary_depth(statement["else_body"])
            if statement_depth > depth:
                depth = statement_depth
        elif statement["kind"] == "while" or statement["kind"] == "for":
            if statement["kind"] == "while":
                statement_depth = 1 + native_direct_expression_temporary_depth(statement["condition"])
                if statement_depth > depth:
                    depth = statement_depth
            if statement["kind"] == "for":
                statement_depth = native_direct_expression_temporary_depth(statement["iterable"])
                if statement_depth > depth:
                    depth = statement_depth
            statement_depth = native_direct_statement_temporary_depth(statement["body"])
            if statement_depth > depth:
                depth = statement_depth
        elif statement["kind"] == "expr":
            statement_depth = native_direct_expression_temporary_depth(statement["value"])
            if statement_depth > depth:
                depth = statement_depth
        idx = idx + 1
    return depth


def native_direct_plan(program, application, target):
    target = backend_require_operation(target, "native-ir-v2-direct")
    if application["contract"] != "tyrion-native-direct-analysis-v1":
        fail("direct-native lowering rejected code=analysis-contract")
    if application["program"] != program:
        fail("direct-native lowering rejected code=analysis-program-mismatch")
    locals = native_direct_collect_locals(program)
    loop_control_slot_count = native_direct_count_for_control_slots(program["items"])
    value_temporary_slot_count = native_direct_statement_temporary_depth(program["items"]) * 4
    aggregate_names = native_direct_aggregate_names(program)
    string_names = native_direct_string_names(program)
    aggregate_core = len(locals) > 0 or loop_control_slot_count > 0 or value_temporary_slot_count > 0
    return {"contract": "tyrion-native-direct-plan-v1", "target": target, "program": program, "application": application["application"], "extensions": [], "locals": locals, "loop_control_slot_count": loop_control_slot_count, "value_temporary_slot_count": value_temporary_slot_count, "aggregate_names": aggregate_names, "string_names": string_names, "aggregate_core": aggregate_core}


def native_direct_constant_id(state, kind, value):
    idx = 0
    while idx < len(state["constants"]):
        constant = state["constants"][idx]
        if constant["kind"] == kind and constant["value"] == value:
            return {"state": state, "id": constant["id"]}
        idx = idx + 1
    constant_id = len(state["constants"])
    state["constants"] = method_append(state["constants"], native_ir_v2_constant(constant_id, kind, value))
    return {"state": state, "id": constant_id}


def native_direct_append_instruction(state, op, value_type, fields):
    if state["terminated"]:
        fail("direct-native lowering rejected code=instruction-after-terminator;op=" + op)
    result = state["next_result"]
    state["next_result"] = result + 1
    state["instructions"] = method_append(state["instructions"], native_ir_v2_instruction(result, op, value_type, fields))
    return {"state": state, "result": result}


def native_direct_finish_block(state, terminator):
    if state["current_block"] != len(state["blocks"]):
        fail("direct-native lowering rejected code=noncanonical-block-completion;block=" + str(state["current_block"]) + ";completed=" + str(len(state["blocks"])))
    state["blocks"] = method_append(state["blocks"], native_ir_v2_block(state["current_block"], state["instructions"], terminator))
    state["instructions"] = []
    state["terminated"] = True
    return state


def native_direct_begin_next_block(state):
    block_id = state["next_block"]
    state["next_block"] = block_id + 1
    state["current_block"] = block_id
    state["instructions"] = []
    state["terminated"] = False
    return state


def native_direct_patch_branch_false_target(state, block_id, target):
    block = state["blocks"][block_id]
    terminator = block["terminator"]
    if terminator["op"] != "branch" or terminator["false_target"] != -1:
        fail("direct-native lowering rejected code=branch-patch-state;block=" + str(block_id))
    terminator["false_target"] = target
    block["terminator"] = terminator
    blocks = state["blocks"]
    blocks[block_id] = block
    state["blocks"] = blocks
    return state


def native_direct_patch_branch_true_target(state, block_id, target):
    block = state["blocks"][block_id]
    terminator = block["terminator"]
    if terminator["op"] != "branch" or terminator["true_target"] != -1:
        fail("direct-native lowering rejected code=branch-patch-state;block=" + str(block_id))
    terminator["true_target"] = target
    block["terminator"] = terminator
    blocks = state["blocks"]
    blocks[block_id] = block
    state["blocks"] = blocks
    return state


def native_direct_patch_jump_target(state, block_id, target):
    block = state["blocks"][block_id]
    terminator = block["terminator"]
    if terminator["op"] != "jump" or terminator["target"] != -1:
        fail("direct-native lowering rejected code=jump-patch-state;block=" + str(block_id))
    terminator["target"] = target
    block["terminator"] = terminator
    blocks = state["blocks"]
    blocks[block_id] = block
    state["blocks"] = blocks
    return state


def native_direct_append_const_int(state, value, value_type):
    return native_direct_append_instruction(state, "const_int", value_type, {"value": value})


def native_direct_append_write_fd(state, fd_value, payload):
    if len(payload) == 0:
        return state
    constant = native_direct_constant_id(state, "bytes", payload)
    state = constant["state"]
    fd = native_direct_append_const_int(state, fd_value, "i32")
    state = fd["state"]
    address = native_direct_append_instruction(state, "const_address", "ptr", {"constant_id": constant["id"]})
    state = address["state"]
    length = native_direct_append_const_int(state, len(payload), "usize")
    state = length["state"]
    call = native_direct_append_instruction(state, "call_external", "isize", {"name": "write", "args": [fd["result"], address["result"], length["result"]]})
    return call["state"]


def native_direct_append_write(state, payload):
    return native_direct_append_write_fd(state, 1, payload)


def native_direct_release_frame_slots(state):
    if not state["aggregate_core"]:
        return state
    slot_idx = 0
    while slot_idx < len(state["frame_slots"]):
        released = native_direct_append_instruction(state, "direct_slot_release", "i32", {"args": [state["frame_slots"][slot_idx]]})
        state = released["state"]
        slot_idx = slot_idx + 1
    return state


def native_direct_literal_text(expr):
    kind = expr["kind"]
    if kind == "string":
        return {"ok": True, "value": expr["value"]}
    if kind == "int":
        return {"ok": True, "value": str(expr["value"])}
    if kind == "bool":
        if expr["value"]:
            return {"ok": True, "value": "True"}
        return {"ok": True, "value": "False"}
    if kind == "none":
        return {"ok": True, "value": "none"}
    return {"ok": False, "value": ""}


def native_direct_local_slot(state, name):
    idx = 0
    while idx < len(state["locals"]):
        if state["locals"][idx]["name"] == name:
            return state["locals"][idx]["slot"]
        idx = idx + 1
    fail("direct-native lowering rejected code=unresolved-local;name=" + name)


def native_direct_name_in_list(names, name):
    idx = 0
    while idx < len(names):
        if names[idx] == name:
            return True
        idx = idx + 1
    return False


def native_direct_local_is_aggregate(state, name):
    return native_direct_name_in_list(state["aggregate_names"], name)


def native_direct_local_is_string(state, name):
    return native_direct_name_in_list(state["string_names"], name)


def native_direct_local_is_owned(state, name):
    return native_direct_local_is_aggregate(state, name) or native_direct_local_is_string(state, name)


def native_direct_mark_local_initialized(state, name):
    if not native_direct_name_in_list(state["initialized_locals"], name):
        state["initialized_locals"] = method_append(state["initialized_locals"], name)
    return state


def native_direct_intersect_initialized(left, right):
    out = []
    idx = 0
    while idx < len(left):
        if native_direct_name_in_list(right, left[idx]):
            out = method_append(out, left[idx])
        idx = idx + 1
    return out


def native_direct_comparison_operation(op):
    if op == "==":
        return "eq"
    if op == "!=":
        return "ne"
    if op == "<":
        return "lt"
    if op == "<=":
        return "le"
    if op == ">":
        return "gt"
    if op == ">=":
        return "ge"
    return ""


def native_direct_lower_scalar_expression(state, expression, path):
    kind = expression["kind"]
    if kind == "int":
        value = native_direct_append_const_int(state, expression["value"], "i32")
        return {"state": value["state"], "result": value["result"], "type": "i32"}
    if kind == "bool":
        int_value = 0
        if expression["value"]:
            int_value = 1
        value = native_direct_append_const_int(state, int_value, "i1")
        return {"state": value["state"], "result": value["result"], "type": "i1"}
    if kind == "var":
        if not native_direct_name_in_list(state["initialized_locals"], expression["value"]):
            fail("direct-native lowering rejected code=local-read-before-assignment;name=" + expression["value"] + ";position=" + path)
        slot = native_direct_local_slot(state, expression["value"])
        value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [slot]})
        return {"state": value["state"], "result": value["result"], "type": "i32"}
    if kind == "binary" and (expression["op"] == "+" or expression["op"] == "-" or expression["op"] == "*"):
        left = native_direct_lower_scalar_expression(state, expression["left"], path + ".left")
        right = native_direct_lower_scalar_expression(left["state"], expression["right"], path + ".right")
        if left["type"] != "i32" or right["type"] != "i32":
            fail("direct-native lowering rejected code=arithmetic-type-not-lowered;position=" + path)
        operation = "add"
        if expression["op"] == "-":
            operation = "sub"
        elif expression["op"] == "*":
            operation = "mul"
        value = native_direct_append_instruction(right["state"], operation, "i32", {"args": [left["result"], right["result"]]})
        return {"state": value["state"], "result": value["result"], "type": "i32"}
    if kind == "binary":
        operation = native_direct_comparison_operation(expression["op"])
        if operation != "":
            left = native_direct_lower_scalar_expression(state, expression["left"], path + ".left")
            right = native_direct_lower_scalar_expression(left["state"], expression["right"], path + ".right")
            if left["type"] != right["type"]:
                fail("direct-native lowering rejected code=comparison-type-mismatch;position=" + path)
            value = native_direct_append_instruction(right["state"], operation, "i1", {"args": [left["result"], right["result"]]})
            return {"state": value["state"], "result": value["result"], "type": "i1"}
    if kind == "unary" and expression["op"] == "not":
        inner = native_direct_lower_condition(state, expression["value"], path + ".value")
        zero = native_direct_append_const_int(inner["state"], 0, "i1")
        value = native_direct_append_instruction(zero["state"], "eq", "i1", {"args": [inner["result"], zero["result"]]})
        return {"state": value["state"], "result": value["result"], "type": "i1"}
    if kind == "unary" and expression["op"] == "-":
        inner = native_direct_lower_scalar_expression(state, expression["value"], path + ".value")
        if inner["type"] != "i32":
            fail("direct-native lowering rejected code=unary-type-not-lowered;position=" + path)
        zero = native_direct_append_const_int(inner["state"], 0, "i32")
        value = native_direct_append_instruction(zero["state"], "sub", "i32", {"args": [zero["result"], inner["result"]]})
        return {"state": value["state"], "result": value["result"], "type": "i32"}
    fail("direct-native lowering rejected code=expression-not-lowered;kind=" + kind + ";position=" + path)


def native_direct_lower_condition(state, expression, path):
    value_slot = native_direct_value_temporary_pair_slot(state, 0, 0, path)
    state = native_direct_lower_value_into_slot(state, expression, value_slot, path, 1)
    condition = native_direct_append_instruction(state, "direct_slot_truthy", "i1", {"args": [value_slot]})
    return {"state": condition["state"], "result": condition["result"], "type": "i1"}


def native_direct_lower_print_statement(state, statement, path):
    if statement["kind"] != "expr":
        fail("direct-native lowering rejected code=statement-not-lowered;kind=" + statement["kind"] + ";position=" + path)
    expression = statement["value"]
    if expression["kind"] != "call" or expression["callee"]["kind"] != "var" or expression["callee"]["value"] != "print":
        fail("direct-native lowering rejected code=statement-not-lowered;kind=" + expression["kind"] + ";position=" + path)
    arg_idx = 0
    while arg_idx < len(expression["args"]):
        argument = expression["args"][arg_idx]
        literal = native_direct_literal_text(argument)
        if arg_idx > 0:
            state = native_direct_append_write(state, " ")
        if literal["ok"]:
            state = native_direct_append_write(state, literal["value"])
        elif argument["kind"] == "var":
            if not native_direct_name_in_list(state["initialized_locals"], argument["value"]):
                fail("direct-native lowering rejected code=local-read-before-assignment;name=" + argument["value"] + ";position=" + path + ".arg[" + str(arg_idx) + "]")
            slot = native_direct_local_slot(state, argument["value"])
            printed = native_direct_append_instruction(state, "direct_print_string_slot", "i32", {"args": [slot]})
            state = printed["state"]
        else:
            value_slot = native_direct_value_temporary_pair_slot(state, 0, 0, path + ".arg[" + str(arg_idx) + "]")
            state = native_direct_lower_value_into_slot(state, argument, value_slot, path + ".arg[" + str(arg_idx) + "]", 1)
            printed = native_direct_append_instruction(state, "direct_print_string_slot", "i32", {"args": [value_slot]})
            state = printed["state"]
        arg_idx = arg_idx + 1
    return native_direct_append_write(state, "\n")


def native_direct_lower_statements(state, statements, path):
    idx = 0
    while idx < len(statements) and not state["terminated"]:
        state = native_direct_lower_statement(state, statements[idx], path + "[" + str(idx) + "]")
        idx = idx + 1
    return state


def native_direct_push_loop(state, continue_target):
    context = {"continue_target": continue_target, "break_blocks": [], "continue_blocks": []}
    state["loop_contexts"] = method_append(state["loop_contexts"], context)
    return state


def native_direct_record_loop_break(state, block_id):
    context_idx = len(state["loop_contexts"]) - 1
    if context_idx < 0:
        fail("direct-native lowering rejected code=break-outside-loop")
    contexts = state["loop_contexts"]
    context = contexts[context_idx]
    context["break_blocks"] = method_append(context["break_blocks"], block_id)
    contexts[context_idx] = context
    state["loop_contexts"] = contexts
    return state


def native_direct_record_loop_continue(state, block_id):
    context_idx = len(state["loop_contexts"]) - 1
    if context_idx < 0:
        fail("direct-native lowering rejected code=continue-outside-loop")
    contexts = state["loop_contexts"]
    context = contexts[context_idx]
    context["continue_blocks"] = method_append(context["continue_blocks"], block_id)
    contexts[context_idx] = context
    state["loop_contexts"] = contexts
    return state


def native_direct_pop_loop(state):
    context_idx = len(state["loop_contexts"]) - 1
    if context_idx < 0:
        fail("direct-native lowering rejected code=loop-context-underflow")
    contexts = state["loop_contexts"]
    context = contexts[context_idx]
    remaining = []
    idx = 0
    while idx < context_idx:
        remaining = method_append(remaining, contexts[idx])
        idx = idx + 1
    state["loop_contexts"] = remaining
    return {"state": state, "context": context}


def native_direct_lower_break_statement(state):
    if len(state["loop_contexts"]) == 0:
        fail("direct-native lowering rejected code=break-outside-loop")
    block_id = state["current_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(-1))
    return native_direct_record_loop_break(state, block_id)


def native_direct_lower_continue_statement(state):
    context_idx = len(state["loop_contexts"]) - 1
    if context_idx < 0:
        fail("direct-native lowering rejected code=continue-outside-loop")
    context = state["loop_contexts"][context_idx]
    block_id = state["current_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(context["continue_target"]))
    return native_direct_record_loop_continue(state, block_id)


def native_direct_lower_if_statement(state, statement, path):
    incoming_initialized = state["initialized_locals"]
    condition_block = state["current_block"]
    condition = native_direct_lower_condition(state, statement["condition"], path + ".condition")
    state = condition["state"]
    true_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(condition["result"], true_block, -1))
    state = native_direct_begin_next_block(state)
    state = native_direct_lower_statements(state, statement["body"], path + ".if")
    exits = []
    merged_initialized = []
    has_live_exit = False
    if not state["terminated"]:
        merged_initialized = state["initialized_locals"]
        has_live_exit = True
        exits = method_append(exits, state["current_block"])
        state = native_direct_finish_block(state, native_ir_v2_jump(-1))

    false_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, false_block)
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    branch_idx = 0
    while branch_idx < len(statement["elifs"]):
        branch = statement["elifs"][branch_idx]
        branch_condition_block = state["current_block"]
        branch_condition = native_direct_lower_condition(state, branch["condition"], path + ".elif[" + str(branch_idx) + "].condition")
        state = branch_condition["state"]
        branch_true_block = state["next_block"]
        state = native_direct_finish_block(state, native_ir_v2_branch(branch_condition["result"], branch_true_block, -1))
        state = native_direct_begin_next_block(state)
        state = native_direct_lower_statements(state, branch["body"], path + ".elif[" + str(branch_idx) + "]")
        if not state["terminated"]:
            if has_live_exit:
                merged_initialized = native_direct_intersect_initialized(merged_initialized, state["initialized_locals"])
            else:
                merged_initialized = state["initialized_locals"]
                has_live_exit = True
            exits = method_append(exits, state["current_block"])
            state = native_direct_finish_block(state, native_ir_v2_jump(-1))
        branch_false_block = state["next_block"]
        state = native_direct_patch_branch_false_target(state, branch_condition_block, branch_false_block)
        state = native_direct_begin_next_block(state)
        state["initialized_locals"] = incoming_initialized
        branch_idx = branch_idx + 1

    state = native_direct_lower_statements(state, statement["else_body"], path + ".else")
    if not state["terminated"]:
        if has_live_exit:
            merged_initialized = native_direct_intersect_initialized(merged_initialized, state["initialized_locals"])
        else:
            merged_initialized = state["initialized_locals"]
            has_live_exit = True
        exits = method_append(exits, state["current_block"])
        state = native_direct_finish_block(state, native_ir_v2_jump(-1))
    if not has_live_exit:
        state["terminated"] = True
        return state
    merge_block = state["next_block"]
    exit_idx = 0
    while exit_idx < len(exits):
        state = native_direct_patch_jump_target(state, exits[exit_idx], merge_block)
        exit_idx = exit_idx + 1
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = merged_initialized
    return state


def native_direct_lower_while_statement(state, statement, path):
    incoming_initialized = state["initialized_locals"]
    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    condition = native_direct_lower_condition(state, statement["condition"], path + ".condition")
    state = condition["state"]
    body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(condition["result"], body_block, -1))
    state = native_direct_begin_next_block(state)
    state = native_direct_push_loop(state, condition_block)
    state = native_direct_lower_statements(state, statement["body"], path + ".body")
    popped = native_direct_pop_loop(state)
    state = popped["state"]
    context = popped["context"]
    if not state["terminated"]:
        state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, exit_block)
    break_idx = 0
    while break_idx < len(context["break_blocks"]):
        state = native_direct_patch_jump_target(state, context["break_blocks"][break_idx], exit_block)
        break_idx = break_idx + 1
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    return state


def native_direct_lower_range_arguments(state, expression, path):
    if expression["kind"] != "call" or expression["callee"]["kind"] != "var" or expression["callee"]["value"] != "range":
        fail("direct-native lowering rejected code=for-iterator-not-lowered;position=" + path)
    args = expression["args"]
    if len(args) < 1 or len(args) > 3:
        fail("direct-native lowering rejected code=range-arity;arity=" + str(len(args)) + ";position=" + path)
    arg_idx = 0
    lowered = []
    while arg_idx < len(args):
        if args[arg_idx]["kind"] == "kwarg":
            fail("direct-native lowering rejected code=range-keyword-not-lowered;position=" + path + ".arg[" + str(arg_idx) + "]")
        value = native_direct_lower_scalar_expression(state, args[arg_idx], path + ".arg[" + str(arg_idx) + "]")
        state = value["state"]
        if value["type"] != "i32":
            fail("direct-native lowering rejected code=range-argument-type-not-lowered;position=" + path + ".arg[" + str(arg_idx) + "]")
        lowered = method_append(lowered, value["result"])
        arg_idx = arg_idx + 1
    if len(lowered) == 1:
        start = native_direct_append_const_int(state, 0, "i32")
        state = start["state"]
        step = native_direct_append_const_int(state, 1, "i32")
        return {"state": step["state"], "start": start["result"], "stop": lowered[0], "step": step["result"]}
    if len(lowered) == 2:
        step = native_direct_append_const_int(state, 1, "i32")
        return {"state": step["state"], "start": lowered[0], "stop": lowered[1], "step": step["result"]}
    return {"state": state, "start": lowered[0], "stop": lowered[1], "step": lowered[2]}


def native_direct_take_loop_control_slot(state, path):
    slot_idx = state["next_loop_control_slot"]
    if slot_idx >= len(state["loop_control_slots"]):
        fail("direct-native lowering rejected code=loop-control-slot-underflow;position=" + path)
    state["next_loop_control_slot"] = slot_idx + 1
    return {"state": state, "slot": state["loop_control_slots"][slot_idx]}


def native_direct_lower_literal_for_statement(state, statement, iterable, enumerate_mode, enumerate_start_expression, path):
    expected_targets = 1
    if enumerate_mode:
        expected_targets = 2
    if len(statement["targets"]) != expected_targets:
        fail("direct-native lowering rejected code=for-literal-target-not-lowered;count=" + str(len(statement["targets"])) + ";expected=" + str(expected_targets) + ";position=" + path)
    incoming_initialized = state["initialized_locals"]
    items = iterable["items"]
    cursor = native_direct_take_loop_control_slot(state, path)
    state = cursor["state"]
    cursor_slot = cursor["slot"]
    item_slots = []
    item_idx = 0
    while item_idx < len(items):
        item_control = native_direct_take_loop_control_slot(state, path)
        state = item_control["state"]
        item_value = native_direct_lower_scalar_expression(state, items[item_idx], path + ".iterable.item[" + str(item_idx) + "]")
        state = item_value["state"]
        if item_value["type"] != "i32":
            fail("direct-native lowering rejected code=for-literal-item-type-not-lowered;position=" + path + ".iterable.item[" + str(item_idx) + "]")
        item_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [item_control["slot"], item_value["result"]]})
        state = item_stored["state"]
        item_slots = method_append(item_slots, item_control["slot"])
        item_idx = item_idx + 1
    enumerate_slot = -1
    enumerate_start = -1
    if enumerate_mode:
        enumerate_control = native_direct_take_loop_control_slot(state, path)
        state = enumerate_control["state"]
        enumerate_slot = enumerate_control["slot"]
        enumerate_start_type = "i32"
        if enumerate_start_expression == none:
            initial = native_direct_append_const_int(state, 0, "i32")
        else:
            initial = native_direct_lower_scalar_expression(state, enumerate_start_expression, path + ".iterable.start")
            enumerate_start_type = initial["type"]
        state = initial["state"]
        if enumerate_start_type != "i32":
            fail("direct-native lowering rejected code=enumerate-start-type-not-lowered;position=" + path + ".iterable.start")
        enumerate_start = initial["result"]
    cursor_zero = native_direct_append_const_int(state, 0, "i32")
    state = cursor_zero["state"]
    cursor_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, cursor_zero["result"]]})
    state = cursor_stored["state"]
    if enumerate_mode:
        enumerate_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_slot, enumerate_start]})
        state = enumerate_stored["state"]
    if len(items) == 0:
        state["initialized_locals"] = incoming_initialized
        return state

    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    cursor_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = cursor_value["state"]
    item_count = native_direct_append_const_int(state, len(items), "i32")
    state = item_count["state"]
    has_item = native_direct_append_instruction(state, "lt", "i1", {"args": [cursor_value["result"], item_count["result"]]})
    state = has_item["state"]
    dispatch_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(has_item["result"], dispatch_block, -1))
    state = native_direct_begin_next_block(state)

    item_exits = []
    value_target_idx = 0
    if enumerate_mode:
        value_target_idx = 1
    target_name = statement["targets"][value_target_idx]
    target_slot = native_direct_local_slot(state, target_name)
    item_idx = 0
    while item_idx < len(items):
        if item_idx < len(items) - 1:
            dispatch_cursor = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
            state = dispatch_cursor["state"]
            dispatch_index = native_direct_append_const_int(state, item_idx, "i32")
            state = dispatch_index["state"]
            is_item = native_direct_append_instruction(state, "eq", "i1", {"args": [dispatch_cursor["result"], dispatch_index["result"]]})
            state = is_item["state"]
            item_block = state["next_block"]
            state = native_direct_finish_block(state, native_ir_v2_branch(is_item["result"], item_block, item_block + 1))
            state = native_direct_begin_next_block(state)
        selected = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [item_slots[item_idx]]})
        state = selected["state"]
        if enumerate_mode:
            enumerate_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [enumerate_slot]})
            state = enumerate_value["state"]
            enumerate_target_name = statement["targets"][0]
            enumerate_target = native_direct_local_slot(state, enumerate_target_name)
            enumerate_published = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_target, enumerate_value["result"]]})
            state = native_direct_mark_local_initialized(enumerate_published["state"], enumerate_target_name)
        published = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [target_slot, selected["result"]]})
        state = native_direct_mark_local_initialized(published["state"], target_name)
        item_exits = method_append(item_exits, state["current_block"])
        state = native_direct_finish_block(state, native_ir_v2_jump(-1))
        if item_idx < len(items) - 1:
            state = native_direct_begin_next_block(state)
        item_idx = item_idx + 1

    body_block = state["next_block"]
    item_idx = 0
    while item_idx < len(item_exits):
        state = native_direct_patch_jump_target(state, item_exits[item_idx], body_block)
        item_idx = item_idx + 1
    state = native_direct_begin_next_block(state)
    state = native_direct_push_loop(state, -1)
    state = native_direct_lower_statements(state, statement["body"], path + ".body")
    popped = native_direct_pop_loop(state)
    state = popped["state"]
    context = popped["context"]
    has_increment = not state["terminated"] or len(context["continue_blocks"]) > 0
    if has_increment:
        increment_block = state["next_block"]
        if not state["terminated"]:
            state = native_direct_finish_block(state, native_ir_v2_jump(increment_block))
        continue_idx = 0
        while continue_idx < len(context["continue_blocks"]):
            state = native_direct_patch_jump_target(state, context["continue_blocks"][continue_idx], increment_block)
            continue_idx = continue_idx + 1
        state = native_direct_begin_next_block(state)
        current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
        state = current["state"]
        one = native_direct_append_const_int(state, 1, "i32")
        state = one["state"]
        next_value = native_direct_append_instruction(state, "add", "i32", {"args": [current["result"], one["result"]]})
        state = next_value["state"]
        next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, next_value["result"]]})
        state = next_stored["state"]
        if enumerate_mode:
            enumerate_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [enumerate_slot]})
            state = enumerate_current["state"]
            enumerate_one = native_direct_append_const_int(state, 1, "i32")
            state = enumerate_one["state"]
            enumerate_next = native_direct_append_instruction(state, "add", "i32", {"args": [enumerate_current["result"], enumerate_one["result"]]})
            state = enumerate_next["state"]
            enumerate_next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_slot, enumerate_next["result"]]})
            state = enumerate_next_stored["state"]
        state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, exit_block)
    break_idx = 0
    while break_idx < len(context["break_blocks"]):
        state = native_direct_patch_jump_target(state, context["break_blocks"][break_idx], exit_block)
        break_idx = break_idx + 1
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    return state


def native_direct_lower_variable_for_statement(state, statement, iterable_expression, enumerate_mode, enumerate_start_expression, path):
    expected_targets = 1
    if enumerate_mode:
        expected_targets = 2
    if len(statement["targets"]) != expected_targets:
        fail("direct-native lowering rejected code=for-variable-target-not-lowered;count=" + str(len(statement["targets"])) + ";expected=" + str(expected_targets) + ";position=" + path)
    iterable_name = iterable_expression["value"]
    if not native_direct_local_is_owned(state, iterable_name):
        fail("direct-native lowering rejected code=for-iterator-not-lowered;position=" + path + ".iterable")
    if not native_direct_name_in_list(state["initialized_locals"], iterable_name):
        fail("direct-native lowering rejected code=local-read-before-assignment;name=" + iterable_name + ";position=" + path + ".iterable")
    incoming_initialized = state["initialized_locals"]
    snapshot = native_direct_take_loop_control_slot(state, path)
    state = snapshot["state"]
    snapshot_slot = snapshot["slot"]
    cursor = native_direct_take_loop_control_slot(state, path)
    state = cursor["state"]
    cursor_slot = cursor["slot"]
    enumerate_slot = -1
    if enumerate_mode:
        enumerate_control = native_direct_take_loop_control_slot(state, path)
        state = enumerate_control["state"]
        enumerate_slot = enumerate_control["slot"]
    iterable_slot = native_direct_local_slot(state, iterable_name)
    copied = native_direct_append_instruction(state, "direct_slot_copy_owned", "slot_ptr", {"args": [snapshot_slot, iterable_slot]})
    state = copied["state"]
    zero = native_direct_append_const_int(state, 0, "i32")
    state = zero["state"]
    cursor_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, zero["result"]]})
    state = cursor_stored["state"]
    if enumerate_mode:
        if enumerate_start_expression == none:
            enumerate_start = native_direct_append_const_int(state, 0, "i32")
        else:
            enumerate_start = native_direct_lower_scalar_expression(state, enumerate_start_expression, path + ".iterable.start")
        state = enumerate_start["state"]
        if enumerate_start["type"] != "i32":
            fail("direct-native lowering rejected code=enumerate-start-type-not-lowered;position=" + path + ".iterable.start")
        enumerate_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_slot, enumerate_start["result"]]})
        state = enumerate_stored["state"]

    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = current["state"]
    count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [snapshot_slot]})
    state = count["state"]
    has_item = native_direct_append_instruction(state, "lt", "i1", {"args": [current["result"], count["result"]]})
    state = has_item["state"]
    body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(has_item["result"], body_block, -1))

    state = native_direct_begin_next_block(state)
    value_target_idx = 0
    if enumerate_mode:
        enumerate_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [enumerate_slot]})
        state = enumerate_value["state"]
        enumerate_target_name = statement["targets"][0]
        enumerate_target_slot = native_direct_local_slot(state, enumerate_target_name)
        enumerate_published = native_direct_append_instruction(state, "direct_slot_set_int_owned", "slot_ptr", {"args": [enumerate_target_slot, enumerate_value["result"]]})
        state = native_direct_mark_local_initialized(enumerate_published["state"], enumerate_target_name)
        value_target_idx = 1
    target_name = statement["targets"][value_target_idx]
    target_slot = native_direct_local_slot(state, target_name)
    item = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [target_slot, snapshot_slot, current["result"]]})
    state = native_direct_mark_local_initialized(item["state"], target_name)
    state = native_direct_push_loop(state, -1)
    state = native_direct_lower_statements(state, statement["body"], path + ".body")
    popped = native_direct_pop_loop(state)
    state = popped["state"]
    context = popped["context"]
    has_increment = not state["terminated"] or len(context["continue_blocks"]) > 0
    if has_increment:
        increment_block = state["next_block"]
        if not state["terminated"]:
            state = native_direct_finish_block(state, native_ir_v2_jump(increment_block))
        continue_idx = 0
        while continue_idx < len(context["continue_blocks"]):
            state = native_direct_patch_jump_target(state, context["continue_blocks"][continue_idx], increment_block)
            continue_idx = continue_idx + 1
        state = native_direct_begin_next_block(state)
        increment_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
        state = increment_current["state"]
        one = native_direct_append_const_int(state, 1, "i32")
        state = one["state"]
        next_value = native_direct_append_instruction(state, "add", "i32", {"args": [increment_current["result"], one["result"]]})
        state = next_value["state"]
        next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, next_value["result"]]})
        state = next_stored["state"]
        if enumerate_mode:
            enumerate_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [enumerate_slot]})
            state = enumerate_current["state"]
            enumerate_one = native_direct_append_const_int(state, 1, "i32")
            state = enumerate_one["state"]
            enumerate_next = native_direct_append_instruction(state, "add", "i32", {"args": [enumerate_current["result"], enumerate_one["result"]]})
            state = enumerate_next["state"]
            enumerate_next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_slot, enumerate_next["result"]]})
            state = enumerate_next_stored["state"]
        state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, exit_block)
    break_idx = 0
    while break_idx < len(context["break_blocks"]):
        state = native_direct_patch_jump_target(state, context["break_blocks"][break_idx], exit_block)
        break_idx = break_idx + 1
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    return state


def native_direct_lower_zip_for_statement(state, statement, expression, path):
    if len(expression["args"]) == 0 or len(statement["targets"]) != len(expression["args"]):
        fail("direct-native lowering rejected code=zip-target-arity;targets=" + str(len(statement["targets"])) + ";iterables=" + str(len(expression["args"])) + ";position=" + path)
    incoming_initialized = state["initialized_locals"]
    snapshots = []
    arg_idx = 0
    while arg_idx < len(expression["args"]):
        argument = expression["args"][arg_idx]
        if argument["kind"] == "kwarg":
            fail("direct-native lowering rejected code=zip-keyword-not-lowered;position=" + path + ".iterable.arg[" + str(arg_idx) + "]")
        snapshot = native_direct_take_loop_control_slot(state, path)
        state = snapshot["state"]
        snapshot_slot = snapshot["slot"]
        if argument["kind"] == "var" and native_direct_local_is_owned(state, argument["value"]):
            if not native_direct_name_in_list(state["initialized_locals"], argument["value"]):
                fail("direct-native lowering rejected code=local-read-before-assignment;name=" + argument["value"] + ";position=" + path + ".iterable.arg[" + str(arg_idx) + "]")
            source_slot = native_direct_local_slot(state, argument["value"])
            copied = native_direct_append_instruction(state, "direct_slot_copy_owned", "slot_ptr", {"args": [snapshot_slot, source_slot]})
            state = copied["state"]
        elif argument["kind"] == "string" or argument["kind"] == "list" or argument["kind"] == "tuple" or argument["kind"] == "set" or argument["kind"] == "dict":
            state = native_direct_lower_value_into_slot(state, argument, snapshot_slot, path + ".iterable.arg[" + str(arg_idx) + "]", 0)
        else:
            fail("direct-native lowering rejected code=zip-iterator-not-lowered;kind=" + argument["kind"] + ";position=" + path + ".iterable.arg[" + str(arg_idx) + "]")
        snapshots = method_append(snapshots, snapshot_slot)
        arg_idx = arg_idx + 1

    cursor = native_direct_take_loop_control_slot(state, path)
    state = cursor["state"]
    cursor_slot = cursor["slot"]
    zero = native_direct_append_const_int(state, 0, "i32")
    state = zero["state"]
    cursor_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, zero["result"]]})
    state = cursor_stored["state"]

    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
    state = current["state"]
    has_all = -1
    snapshot_idx = 0
    while snapshot_idx < len(snapshots):
        count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [snapshots[snapshot_idx]]})
        state = count["state"]
        has_item = native_direct_append_instruction(state, "lt", "i1", {"args": [current["result"], count["result"]]})
        state = has_item["state"]
        if has_all < 0:
            has_all = has_item["result"]
        else:
            combined = native_direct_append_instruction(state, "and_i1", "i1", {"args": [has_all, has_item["result"]]})
            state = combined["state"]
            has_all = combined["result"]
        snapshot_idx = snapshot_idx + 1
    body_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(has_all, body_block, -1))

    state = native_direct_begin_next_block(state)
    target_idx = 0
    while target_idx < len(statement["targets"]):
        target_name = statement["targets"][target_idx]
        target_slot = native_direct_local_slot(state, target_name)
        item = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [target_slot, snapshots[target_idx], current["result"]]})
        state = native_direct_mark_local_initialized(item["state"], target_name)
        target_idx = target_idx + 1
    state = native_direct_push_loop(state, -1)
    state = native_direct_lower_statements(state, statement["body"], path + ".body")
    popped = native_direct_pop_loop(state)
    state = popped["state"]
    context = popped["context"]
    has_increment = not state["terminated"] or len(context["continue_blocks"]) > 0
    if has_increment:
        increment_block = state["next_block"]
        if not state["terminated"]:
            state = native_direct_finish_block(state, native_ir_v2_jump(increment_block))
        continue_idx = 0
        while continue_idx < len(context["continue_blocks"]):
            state = native_direct_patch_jump_target(state, context["continue_blocks"][continue_idx], increment_block)
            continue_idx = continue_idx + 1
        state = native_direct_begin_next_block(state)
        increment_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [cursor_slot]})
        state = increment_current["state"]
        one = native_direct_append_const_int(state, 1, "i32")
        state = one["state"]
        next_value = native_direct_append_instruction(state, "add", "i32", {"args": [increment_current["result"], one["result"]]})
        state = next_value["state"]
        next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [cursor_slot, next_value["result"]]})
        state = native_direct_finish_block(next_stored["state"], native_ir_v2_jump(condition_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, exit_block)
    break_idx = 0
    while break_idx < len(context["break_blocks"]):
        state = native_direct_patch_jump_target(state, context["break_blocks"][break_idx], exit_block)
        break_idx = break_idx + 1
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    return state


def native_direct_lower_for_statement(state, statement, path):
    incoming_initialized = state["initialized_locals"]
    iterable = statement["iterable"]
    if iterable["kind"] == "list" or iterable["kind"] == "tuple":
        return native_direct_lower_literal_for_statement(state, statement, iterable, False, none, path)
    if iterable["kind"] == "var":
        return native_direct_lower_variable_for_statement(state, statement, iterable, False, none, path)
    if iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "zip":
        return native_direct_lower_zip_for_statement(state, statement, iterable, path)
    range_expression = iterable
    enumerate_mode = False
    enumerate_start_expression = none
    if iterable["kind"] == "call" and iterable["callee"]["kind"] == "var" and iterable["callee"]["value"] == "enumerate":
        enumerate_mode = True
        if len(iterable["args"]) < 1 or len(iterable["args"]) > 2:
            fail("direct-native lowering rejected code=enumerate-arity;arity=" + str(len(iterable["args"])) + ";position=" + path + ".iterable")
        if iterable["args"][0]["kind"] == "kwarg":
            fail("direct-native lowering rejected code=enumerate-iterable-keyword;position=" + path + ".iterable.arg[0]")
        range_expression = iterable["args"][0]
        if len(iterable["args"]) == 2:
            enumerate_start_expression = iterable["args"][1]
            if enumerate_start_expression["kind"] == "kwarg":
                if enumerate_start_expression["name"] != "start":
                    fail("direct-native lowering rejected code=enumerate-keyword;name=" + enumerate_start_expression["name"] + ";position=" + path + ".iterable.arg[1]")
                enumerate_start_expression = enumerate_start_expression["value"]
    if enumerate_mode and (range_expression["kind"] == "list" or range_expression["kind"] == "tuple"):
        return native_direct_lower_literal_for_statement(state, statement, range_expression, True, enumerate_start_expression, path)
    if enumerate_mode and range_expression["kind"] == "var":
        return native_direct_lower_variable_for_statement(state, statement, range_expression, True, enumerate_start_expression, path)
    expected_targets = 1
    if enumerate_mode:
        expected_targets = 2
    if len(statement["targets"]) != expected_targets:
        fail("direct-native lowering rejected code=for-target-not-lowered;count=" + str(len(statement["targets"])) + ";expected=" + str(expected_targets) + ";position=" + path)
    arguments = native_direct_lower_range_arguments(state, range_expression, path + ".iterable.range")
    state = arguments["state"]
    enumerate_start = -1
    if enumerate_mode:
        enumerate_start_type = "i32"
        if enumerate_start_expression == none:
            initial = native_direct_append_const_int(state, 0, "i32")
        else:
            initial = native_direct_lower_scalar_expression(state, enumerate_start_expression, path + ".iterable.start")
            enumerate_start_type = initial["type"]
        state = initial["state"]
        if enumerate_start_type != "i32":
            fail("direct-native lowering rejected code=enumerate-start-type-not-lowered;position=" + path + ".iterable.start")
        enumerate_start = initial["result"]
    cursor = native_direct_take_loop_control_slot(state, path)
    state = cursor["state"]
    range_slot = cursor["slot"]
    enumerate_slot = -1
    if enumerate_mode:
        enumerate_control = native_direct_take_loop_control_slot(state, path)
        state = enumerate_control["state"]
        enumerate_slot = enumerate_control["slot"]
    stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [range_slot, arguments["start"]]})
    state = stored["state"]
    if enumerate_mode:
        enumerate_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_slot, enumerate_start]})
        state = enumerate_stored["state"]

    condition_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))
    state = native_direct_begin_next_block(state)
    zero = native_direct_append_const_int(state, 0, "i32")
    state = zero["state"]
    zero_step = native_direct_append_instruction(state, "eq", "i1", {"args": [arguments["step"], zero["result"]]})
    state = zero_step["state"]
    zero_step_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(zero_step["result"], zero_step_block, -1))

    state = native_direct_begin_next_block(state)
    state = native_direct_append_write_fd(state, 2, "range() arg 3 must not be zero\n")
    state = native_direct_release_frame_slots(state)
    failure = native_direct_append_const_int(state, 3, "i32")
    state = native_direct_finish_block(failure["state"], native_ir_v2_return(failure["result"]))

    sign_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, sign_block)
    state = native_direct_begin_next_block(state)
    sign_zero = native_direct_append_const_int(state, 0, "i32")
    state = sign_zero["state"]
    positive = native_direct_append_instruction(state, "gt", "i1", {"args": [arguments["step"], sign_zero["result"]]})
    state = positive["state"]
    positive_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(positive["result"], positive_block, positive_block + 1))

    state = native_direct_begin_next_block(state)
    positive_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [range_slot]})
    state = positive_value["state"]
    positive_condition = native_direct_append_instruction(state, "lt", "i1", {"args": [positive_value["result"], arguments["stop"]]})
    positive_condition_block = state["current_block"]
    state = native_direct_finish_block(positive_condition["state"], native_ir_v2_branch(positive_condition["result"], -1, -1))

    state = native_direct_begin_next_block(state)
    negative_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [range_slot]})
    state = negative_value["state"]
    negative_condition = native_direct_append_instruction(state, "gt", "i1", {"args": [negative_value["result"], arguments["stop"]]})
    negative_condition_block = state["current_block"]
    body_block = state["next_block"]
    state = native_direct_finish_block(negative_condition["state"], native_ir_v2_branch(negative_condition["result"], body_block, -1))
    state = native_direct_patch_branch_true_target(state, positive_condition_block, body_block)

    state = native_direct_begin_next_block(state)
    iteration_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [range_slot]})
    state = iteration_value["state"]
    value_target_idx = 0
    if enumerate_mode:
        enumerate_value = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [enumerate_slot]})
        state = enumerate_value["state"]
        enumerate_target = native_direct_local_slot(state, statement["targets"][0])
        enumerate_target_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_target, enumerate_value["result"]]})
        state = native_direct_mark_local_initialized(enumerate_target_stored["state"], statement["targets"][0])
        value_target_idx = 1
    value_target_name = statement["targets"][value_target_idx]
    value_target = native_direct_local_slot(state, value_target_name)
    iteration_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [value_target, iteration_value["result"]]})
    state = native_direct_mark_local_initialized(iteration_stored["state"], value_target_name)
    state = native_direct_push_loop(state, -1)
    state = native_direct_lower_statements(state, statement["body"], path + ".body")
    popped = native_direct_pop_loop(state)
    state = popped["state"]
    context = popped["context"]
    has_increment = not state["terminated"] or len(context["continue_blocks"]) > 0
    if has_increment:
        increment_block = state["next_block"]
        if not state["terminated"]:
            state = native_direct_finish_block(state, native_ir_v2_jump(increment_block))
        continue_idx = 0
        while continue_idx < len(context["continue_blocks"]):
            state = native_direct_patch_jump_target(state, context["continue_blocks"][continue_idx], increment_block)
            continue_idx = continue_idx + 1
        state = native_direct_begin_next_block(state)
        current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [range_slot]})
        state = current["state"]
        next_value = native_direct_append_instruction(state, "add", "i32", {"args": [current["result"], arguments["step"]]})
        state = next_value["state"]
        next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [range_slot, next_value["result"]]})
        state = next_stored["state"]
        if enumerate_mode:
            enumerate_current = native_direct_append_instruction(state, "slot_get_int", "i32", {"args": [enumerate_slot]})
            state = enumerate_current["state"]
            one = native_direct_append_const_int(state, 1, "i32")
            state = one["state"]
            enumerate_next = native_direct_append_instruction(state, "add", "i32", {"args": [enumerate_current["result"], one["result"]]})
            state = enumerate_next["state"]
            enumerate_next_stored = native_direct_append_instruction(state, "slot_set_int", "slot_ptr", {"args": [enumerate_slot, enumerate_next["result"]]})
            state = enumerate_next_stored["state"]
        state = native_direct_finish_block(state, native_ir_v2_jump(condition_block))

    exit_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, positive_condition_block, exit_block)
    state = native_direct_patch_branch_false_target(state, negative_condition_block, exit_block)
    break_idx = 0
    while break_idx < len(context["break_blocks"]):
        state = native_direct_patch_jump_target(state, context["break_blocks"][break_idx], exit_block)
        break_idx = break_idx + 1
    state = native_direct_begin_next_block(state)
    state["initialized_locals"] = incoming_initialized
    return state


def native_direct_value_temporary_slot(state, depth, path):
    slot_idx = depth * 4
    if depth < 0 or slot_idx >= len(state["value_temporary_slots"]):
        fail("direct-native lowering rejected code=value-temporary-slot-underflow;depth=" + str(depth) + ";position=" + path)
    return state["value_temporary_slots"][slot_idx]


def native_direct_value_temporary_pair_slot(state, depth, pair_index, path):
    slot_idx = depth * 4 + pair_index
    if depth < 0 or pair_index < 0 or pair_index > 3 or slot_idx >= len(state["value_temporary_slots"]):
        fail("direct-native lowering rejected code=value-temporary-pair-slot-underflow;depth=" + str(depth) + ";pair=" + str(pair_index) + ";position=" + path)
    return state["value_temporary_slots"][slot_idx]


def native_direct_lower_short_circuit_into_slot(state, expression, destination_slot, path, temporary_depth):
    left_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 0, path + ".left")
    state = native_direct_lower_value_into_slot(state, expression["left"], left_slot, path + ".left", temporary_depth + 1)
    truthy = native_direct_append_instruction(state, "direct_slot_truthy", "i1", {"args": [left_slot]})
    state = truthy["state"]
    first_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(truthy["result"], first_block, -1))
    condition_block = state["current_block"]
    state = native_direct_begin_next_block(state)
    if expression["op"] == "and":
        right_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 1, path + ".right")
        state = native_direct_lower_value_into_slot(state, expression["right"], right_slot, path + ".right", temporary_depth + 1)
        right_truthy = native_direct_append_instruction(state, "direct_slot_truthy", "i1", {"args": [right_slot]})
        stored = native_direct_append_instruction(right_truthy["state"], "direct_slot_set_bool_owned", "slot_ptr", {"args": [destination_slot, right_truthy["result"]]})
        state = stored["state"]
    else:
        stored = native_direct_append_instruction(state, "direct_slot_set_bool_owned", "slot_ptr", {"args": [destination_slot, truthy["result"]]})
        state = stored["state"]
    first_exit = state["current_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(-1))

    second_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, second_block)
    state = native_direct_begin_next_block(state)
    if expression["op"] == "and":
        stored = native_direct_append_instruction(state, "direct_slot_set_bool_owned", "slot_ptr", {"args": [destination_slot, truthy["result"]]})
        state = stored["state"]
    else:
        right_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 1, path + ".right")
        state = native_direct_lower_value_into_slot(state, expression["right"], right_slot, path + ".right", temporary_depth + 1)
        right_truthy = native_direct_append_instruction(state, "direct_slot_truthy", "i1", {"args": [right_slot]})
        stored = native_direct_append_instruction(right_truthy["state"], "direct_slot_set_bool_owned", "slot_ptr", {"args": [destination_slot, right_truthy["result"]]})
        state = stored["state"]
    second_exit = state["current_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(-1))

    merge_block = state["next_block"]
    state = native_direct_patch_jump_target(state, first_exit, merge_block)
    state = native_direct_patch_jump_target(state, second_exit, merge_block)
    return native_direct_begin_next_block(state)


def native_direct_lower_value_into_slot(state, expression, destination_slot, path, temporary_depth):
    kind = expression["kind"]
    if kind == "string":
        constant = native_direct_constant_id(state, "bytes", expression["value"])
        state = constant["state"]
        address = native_direct_append_instruction(state, "const_address", "ptr", {"constant_id": constant["id"]})
        state = address["state"]
        length = native_direct_append_const_int(state, len(expression["value"]), "usize")
        state = length["state"]
        stored = native_direct_append_instruction(state, "direct_slot_set_string", "slot_ptr", {"args": [destination_slot, address["result"], length["result"]]})
        return stored["state"]
    if kind == "none":
        operation = "slot_set_none"
        if state["aggregate_core"]:
            operation = "direct_slot_set_none_owned"
        stored = native_direct_append_instruction(state, operation, "slot_ptr", {"args": [destination_slot]})
        return stored["state"]
    if kind == "bool":
        value = native_direct_lower_scalar_expression(state, expression, path)
        operation = "slot_set_bool"
        if state["aggregate_core"]:
            operation = "direct_slot_set_bool_owned"
        stored = native_direct_append_instruction(value["state"], operation, "slot_ptr", {"args": [destination_slot, value["result"]]})
        return stored["state"]
    if kind == "float":
        constant = native_direct_constant_id(state, "bytes", str(expression["value"]))
        state = constant["state"]
        address = native_direct_append_instruction(state, "const_address", "ptr", {"constant_id": constant["id"]})
        stored = native_direct_append_instruction(address["state"], "direct_slot_set_float_text", "slot_ptr", {"args": [destination_slot, address["result"]]})
        return stored["state"]
    if kind == "var":
        if not native_direct_name_in_list(state["initialized_locals"], expression["value"]):
            fail("direct-native lowering rejected code=local-read-before-assignment;name=" + expression["value"] + ";position=" + path)
        source_slot = native_direct_local_slot(state, expression["value"])
        copied = native_direct_append_instruction(state, "direct_slot_copy_owned", "slot_ptr", {"args": [destination_slot, source_slot]})
        return copied["state"]
    if kind == "list" or kind == "tuple" or kind == "set":
        created = native_direct_append_instruction(state, "direct_slot_collection_new", "slot_ptr", {"args": [destination_slot], "collection_kind": kind, "capacity": len(expression["items"])})
        state = created["state"]
        item_idx = 0
        while item_idx < len(expression["items"]):
            item_slot = native_direct_value_temporary_slot(state, temporary_depth, path + ".item[" + str(item_idx) + "]")
            state = native_direct_lower_value_into_slot(state, expression["items"][item_idx], item_slot, path + ".item[" + str(item_idx) + "]", temporary_depth + 1)
            appended = native_direct_append_instruction(state, "direct_collection_append_owned", "i32", {"args": [destination_slot, item_slot]})
            state = appended["state"]
            item_idx = item_idx + 1
        return state
    if kind == "dict":
        created = native_direct_append_instruction(state, "direct_slot_dict_new", "slot_ptr", {"args": [destination_slot], "capacity": len(expression["entries"])})
        state = created["state"]
        entry_idx = 0
        while entry_idx < len(expression["entries"]):
            key_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 0, path + ".entry[" + str(entry_idx) + "].key")
            value_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 1, path + ".entry[" + str(entry_idx) + "].value")
            state = native_direct_lower_value_into_slot(state, expression["entries"][entry_idx]["key"], key_slot, path + ".entry[" + str(entry_idx) + "].key", temporary_depth + 1)
            state = native_direct_lower_value_into_slot(state, expression["entries"][entry_idx]["value"], value_slot, path + ".entry[" + str(entry_idx) + "].value", temporary_depth + 1)
            inserted = native_direct_append_instruction(state, "direct_dict_put_owned", "i32", {"args": [destination_slot, key_slot, value_slot]})
            state = inserted["state"]
            entry_idx = entry_idx + 1
        return state
    if kind == "binary" and (expression["op"] == "and" or expression["op"] == "or"):
        return native_direct_lower_short_circuit_into_slot(state, expression, destination_slot, path, temporary_depth)
    if kind == "binary":
        left_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 0, path + ".left")
        right_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 1, path + ".right")
        state = native_direct_lower_value_into_slot(state, expression["left"], left_slot, path + ".left", temporary_depth + 1)
        state = native_direct_lower_value_into_slot(state, expression["right"], right_slot, path + ".right", temporary_depth + 1)
        lowered = native_direct_append_instruction(state, "direct_slot_binary", "i32", {"args": [destination_slot, left_slot, right_slot], "operator": expression["op"]})
        return lowered["state"]
    if kind == "unary":
        value_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 0, path + ".value")
        state = native_direct_lower_value_into_slot(state, expression["value"], value_slot, path + ".value", temporary_depth + 1)
        lowered = native_direct_append_instruction(state, "direct_slot_unary", "i32", {"args": [destination_slot, value_slot], "operator": expression["op"]})
        return lowered["state"]
    if kind == "index":
        receiver_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 0, path + ".receiver")
        index_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 1, path + ".index")
        state = native_direct_lower_value_into_slot(state, expression["receiver"], receiver_slot, path + ".receiver", temporary_depth + 1)
        state = native_direct_lower_value_into_slot(state, expression["index"], index_slot, path + ".index", temporary_depth + 1)
        lowered = native_direct_append_instruction(state, "direct_slot_index", "i32", {"args": [destination_slot, receiver_slot, index_slot]})
        return lowered["state"]
    if kind == "slice":
        receiver_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 0, path + ".receiver")
        start_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 1, path + ".start")
        stop_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 2, path + ".stop")
        state = native_direct_lower_value_into_slot(state, expression["receiver"], receiver_slot, path + ".receiver", temporary_depth + 1)
        state = native_direct_lower_value_into_slot(state, expression["start"], start_slot, path + ".start", temporary_depth + 1)
        state = native_direct_lower_value_into_slot(state, expression["stop"], stop_slot, path + ".stop", temporary_depth + 1)
        lowered = native_direct_append_instruction(state, "direct_slot_slice", "i32", {"args": [destination_slot, receiver_slot, start_slot, stop_slot]})
        return lowered["state"]
    if kind == "call" and expression["callee"]["kind"] == "var" and expression["callee"]["value"] == "len" and len(expression["args"]) == 1:
        argument_slot = native_direct_value_temporary_pair_slot(state, temporary_depth, 0, path + ".arg[0]")
        state = native_direct_lower_value_into_slot(state, expression["args"][0], argument_slot, path + ".arg[0]", temporary_depth + 1)
        length = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [argument_slot]})
        stored = native_direct_append_instruction(length["state"], "direct_slot_set_int_owned", "slot_ptr", {"args": [destination_slot, length["result"]]})
        return stored["state"]
    value = native_direct_lower_scalar_expression(state, expression, path)
    if value["type"] != "i32":
        fail("direct-native lowering rejected code=assignment-type-not-lowered;position=" + path)
    operation = "slot_set_int"
    if state["aggregate_core"]:
        operation = "direct_slot_set_int_owned"
    stored = native_direct_append_instruction(value["state"], operation, "slot_ptr", {"args": [destination_slot, value["result"]]})
    return stored["state"]


def native_direct_lower_unpack_assignment(state, statement, path):
    target = statement["target"]
    iterable_slot = native_direct_value_temporary_pair_slot(state, 0, 0, path + ".value")
    state = native_direct_lower_value_into_slot(state, statement["value"], iterable_slot, path + ".value", 1)
    count = native_direct_append_instruction(state, "direct_iterable_count", "i32", {"args": [iterable_slot]})
    state = count["state"]
    star_idx = -1
    target_idx = 0
    while target_idx < len(target["targets"]):
        if target["targets"][target_idx]["star"]:
            star_idx = target_idx
        target_idx = target_idx + 1
    required_count = len(target["targets"])
    compare_operation = "eq"
    if star_idx >= 0:
        required_count = required_count - 1
        compare_operation = "ge"
    required = native_direct_append_const_int(state, required_count, "i32")
    state = required["state"]
    size_ok = native_direct_append_instruction(state, compare_operation, "i1", {"args": [count["result"], required["result"]]})
    state = size_ok["state"]
    condition_block = state["current_block"]
    success_block = state["next_block"]
    state = native_direct_finish_block(state, native_ir_v2_branch(size_ok["result"], success_block, -1))

    state = native_direct_begin_next_block(state)
    target_idx = 0
    while target_idx < len(target["targets"]):
        unpack_target = target["targets"][target_idx]
        target_slot = native_direct_local_slot(state, unpack_target["name"])
        if unpack_target["star"]:
            start = native_direct_append_const_int(state, target_idx, "i32")
            state = start["state"]
            trailing_count = len(target["targets"]) - target_idx - 1
            stop_result = count["result"]
            if trailing_count > 0:
                trailing = native_direct_append_const_int(state, trailing_count, "i32")
                state = trailing["state"]
                stop = native_direct_append_instruction(state, "sub", "i32", {"args": [count["result"], trailing["result"]]})
                state = stop["state"]
                stop_result = stop["result"]
            copied = native_direct_append_instruction(state, "direct_slot_unpack_star", "i32", {"args": [target_slot, iterable_slot, start["result"], stop_result]})
            state = copied["state"]
        else:
            item_index_result = -1
            if star_idx >= 0 and target_idx > star_idx:
                trailing_count = len(target["targets"]) - target_idx
                trailing = native_direct_append_const_int(state, trailing_count, "i32")
                state = trailing["state"]
                item_index = native_direct_append_instruction(state, "sub", "i32", {"args": [count["result"], trailing["result"]]})
                state = item_index["state"]
                item_index_result = item_index["result"]
            else:
                item_index = native_direct_append_const_int(state, target_idx, "i32")
                state = item_index["state"]
                item_index_result = item_index["result"]
            copied = native_direct_append_instruction(state, "direct_iterable_item_copy", "i32", {"args": [target_slot, iterable_slot, item_index_result]})
            state = copied["state"]
        state = native_direct_mark_local_initialized(state, unpack_target["name"])
        target_idx = target_idx + 1
    success_exit = state["current_block"]
    state = native_direct_finish_block(state, native_ir_v2_jump(-1))

    failure_block = state["next_block"]
    state = native_direct_patch_branch_false_target(state, condition_block, failure_block)
    state = native_direct_begin_next_block(state)
    state = native_direct_append_write_fd(state, 2, "unpack assignment size mismatch\n")
    state = native_direct_release_frame_slots(state)
    failure = native_direct_append_const_int(state, 3, "i32")
    state = native_direct_finish_block(failure["state"], native_ir_v2_return(failure["result"]))

    merge_block = state["next_block"]
    state = native_direct_patch_jump_target(state, success_exit, merge_block)
    return native_direct_begin_next_block(state)


def native_direct_lower_statement(state, statement, path):
    if statement["kind"] == "assign" and statement["target"]["kind"] == "var":
        target_name = statement["target"]["value"]
        target_slot = native_direct_local_slot(state, target_name)
        state = native_direct_lower_value_into_slot(state, statement["value"], target_slot, path + ".value", 0)
        return native_direct_mark_local_initialized(state, target_name)
    if statement["kind"] == "assign" and statement["target"]["kind"] == "index":
        target = statement["target"]
        if target["receiver"]["kind"] != "var":
            fail("direct-native lowering rejected code=index-assignment-receiver-not-lowered;position=" + path + ".target.receiver")
        receiver_name = target["receiver"]["value"]
        if not native_direct_name_in_list(state["initialized_locals"], receiver_name):
            fail("direct-native lowering rejected code=local-read-before-assignment;name=" + receiver_name + ";position=" + path + ".target.receiver")
        receiver_slot = native_direct_local_slot(state, receiver_name)
        index_slot = native_direct_value_temporary_pair_slot(state, 0, 0, path + ".target.index")
        value_slot = native_direct_value_temporary_pair_slot(state, 0, 1, path + ".value")
        state = native_direct_lower_value_into_slot(state, target["index"], index_slot, path + ".target.index", 1)
        state = native_direct_lower_value_into_slot(state, statement["value"], value_slot, path + ".value", 1)
        stored = native_direct_append_instruction(state, "direct_slot_index_set", "i32", {"args": [receiver_slot, index_slot, value_slot]})
        return stored["state"]
    if statement["kind"] == "assign" and statement["target"]["kind"] == "unpack":
        return native_direct_lower_unpack_assignment(state, statement, path)
    if statement["kind"] == "if":
        return native_direct_lower_if_statement(state, statement, path)
    if statement["kind"] == "while":
        return native_direct_lower_while_statement(state, statement, path)
    if statement["kind"] == "for":
        return native_direct_lower_for_statement(state, statement, path)
    if statement["kind"] == "break":
        return native_direct_lower_break_statement(state)
    if statement["kind"] == "continue":
        return native_direct_lower_continue_statement(state)
    return native_direct_lower_print_statement(state, statement, path)


def native_direct_module_from_plan(plan):
    if plan["contract"] != "tyrion-native-direct-plan-v1":
        fail("direct-native lowering rejected code=plan-contract")
    state = {"blocks": [], "current_block": 0, "next_block": 1, "instructions": [], "constants": [], "next_result": 0, "locals": [], "initialized_locals": [], "loop_contexts": [], "loop_control_slots": [], "next_loop_control_slot": 0, "value_temporary_slots": [], "aggregate_names": plan["aggregate_names"], "string_names": plan["string_names"], "aggregate_core": plan["aggregate_core"], "frame_slots": [], "terminated": False}
    local_idx = 0
    while local_idx < len(plan["locals"]):
        allocated = native_direct_append_instruction(state, "slot_alloc", "slot_ptr", {"args": []})
        state = allocated["state"]
        zeroed = native_direct_append_instruction(state, "slot_zero", "slot_ptr", {"args": [allocated["result"]]})
        state = zeroed["state"]
        state["locals"] = method_append(state["locals"], {"name": plan["locals"][local_idx]["name"], "slot": zeroed["result"]})
        state["frame_slots"] = method_append(state["frame_slots"], zeroed["result"])
        local_idx = local_idx + 1
    control_slot_idx = 0
    while control_slot_idx < plan["loop_control_slot_count"]:
        allocated = native_direct_append_instruction(state, "slot_alloc", "slot_ptr", {"args": []})
        state = allocated["state"]
        zeroed = native_direct_append_instruction(state, "slot_zero", "slot_ptr", {"args": [allocated["result"]]})
        state = zeroed["state"]
        state["loop_control_slots"] = method_append(state["loop_control_slots"], zeroed["result"])
        state["frame_slots"] = method_append(state["frame_slots"], zeroed["result"])
        control_slot_idx = control_slot_idx + 1
    temporary_slot_idx = 0
    while temporary_slot_idx < plan["value_temporary_slot_count"]:
        allocated = native_direct_append_instruction(state, "slot_alloc", "slot_ptr", {"args": []})
        state = allocated["state"]
        zeroed = native_direct_append_instruction(state, "slot_zero", "slot_ptr", {"args": [allocated["result"]]})
        state = zeroed["state"]
        state["value_temporary_slots"] = method_append(state["value_temporary_slots"], zeroed["result"])
        state["frame_slots"] = method_append(state["frame_slots"], zeroed["result"])
        temporary_slot_idx = temporary_slot_idx + 1
    state = native_direct_lower_statements(state, plan["program"]["items"], "program")
    exit_value = native_direct_append_const_int(state, 0, "i32")
    state = exit_value["state"]
    state = native_direct_release_frame_slots(state)
    state = native_direct_finish_block(state, native_ir_v2_return(exit_value["result"]))
    frame = native_ir_v2_frame(len(plan["locals"]), plan["loop_control_slot_count"], plan["value_temporary_slot_count"], state["next_result"])
    function = native_ir_v2_function(0, "main", "public", [], "i32", frame, state["blocks"])
    function["effects"] = ["io"]
    if plan["aggregate_core"]:
        function["ownership"] = "owned-frame-cleanup"
    functions = []
    functions.append(function)
    externals = []
    externals.append({"name": "write", "parameters": ["i32", "ptr", "usize"], "result_type": "isize", "effect": "io"})
    components = []
    components.append("scalar-core")
    components.append("print")
    if plan["aggregate_core"]:
        components.append("aggregate-core")
    module = native_ir_v2_module(functions, state["constants"], externals, components, True)
    if plan["aggregate_core"]:
        module["ownership_manifest"] = "direct-owned-aggregate"
    return module


def native_direct_module_from_program(program, target, extensions):
    if len(extensions) != 0:
        fail("direct-native lowering rejected code=extensions-not-lowered")
    application = native_direct_analyze(program, target)
    plan = native_direct_plan(program, application, target)
    plan["extensions"] = extensions
    return verify_native_ir(native_direct_module_from_plan(plan))


def native_direct_path_module(path, target, extensions):
    source = read_module_graph(path)
    program = parse_program(lex(source))
    return native_direct_module_from_program(program, target, extensions)


def native_direct_source_module(source, target):
    program = parse_program(lex(source))
    return native_direct_module_from_program(program, target, [])


def native_direct_source_summary(source):
    module = native_direct_source_module(source, target_spec("linux", "x86_64"))
    function = module["functions"][0]
    instruction_count = 0
    block_idx = 0
    while block_idx < len(function["blocks"]):
        instruction_count = instruction_count + len(function["blocks"][block_idx]["instructions"])
        block_idx = block_idx + 1
    return module["contract"] + ":functions=" + str(len(module["functions"])) + ":blocks=" + str(len(function["blocks"])) + ":constants=" + str(len(module["constants"])) + ":instructions=" + str(instruction_count)


def native_direct_plan_summary(source):
    target = target_spec("linux", "x86_64")
    program = parse_program(lex(source))
    analysis = native_direct_analyze(program, target)
    plan = native_direct_plan(program, analysis, target)
    local_names = ""
    idx = 0
    while idx < len(plan["locals"]):
        if idx > 0:
            local_names = local_names + ","
        local_names = local_names + plan["locals"][idx]["name"]
        idx = idx + 1
    application = plan["application"]
    return plan["contract"] + ":locals=" + local_names + ":operations=" + str(len(application["operations"])) + ":value-kinds=" + str(len(application["value_kinds"])) + ":calls=" + str(len(application["call_kinds"])) + ":components=" + str(len(application["components"]))
