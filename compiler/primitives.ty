# Canonical primitive ABI schema.
#
# Rows are intentionally scalar and deterministic so the C seed and every
# generated compiler consume the same representation without host objects.
# Fields:
# id|public|symbol|min|max|keywords|args|result|ownership|effects|capability|impl|dispatch

def primitive_schema_count():
    return 40

def primitive_schema_public_name(index):
    if index < 12:
        if index == 0:
            return "len"
        if index == 1:
            return "int"
        if index == 2:
            return "str"
        if index == 3:
            return "range"
        if index == 4:
            return "open"
        if index == 5:
            return "read_key"
        if index == 6:
            return "ansi_escape"
        if index == 7:
            return "__tyrion_native_wall_time"
        if index == 8:
            return "__tyrion_native_tcp_connect"
        if index == 9:
            return "std_io_tcp_connect"
        if index == 10:
            return "__tyrion_native_tcp_write"
        if index == 11:
            return "std_io_tcp_write"
        fail("primitive schema public name index out of range")
    else:
        index = index - 12
        if index == 0:
            return "__tyrion_native_tcp_read"
        if index == 1:
            return "std_io_tcp_read"
        if index == 2:
            return "__tyrion_native_tcp_close"
        if index == 3:
            return "std_io_tcp_close"
        if index == 4:
            return "read_text_file"
        if index == 5:
            return "read_module_graph"
        if index == 6:
            return "write_text_file"
        if index == 7:
            return "run_tool"
        if index == 8:
            return "asm_writer_open"
        if index == 9:
            return "asm_writer_append"
        if index == 10:
            return "asm_writer_close"
        if index == 11:
            return "asm_writer_bytes"
        if index == 12:
            return "asm_writer_set_backend"
        if index == 13:
            return "asm_writer_is_x86"
        if index == 14:
            return "float"
        if index == 15:
            return "enumerate"
        if index == 16:
            return "bool"
        if index == 17:
            return "zip"
        if index == 18:
            return "sum"
        if index == 19:
            return "min"
        if index == 20:
            return "max"
        if index == 21:
            return "any"
        if index == 22:
            return "all"
        if index == 23:
            return "sorted"
        if index == 24:
            return "time"
        if index == 25:
            return "__tyrion_native_host_load"
        if index == 26:
            return "__tyrion_native_host_call"
        if index == 27:
            return "__tyrion_native_host_unload"
        fail("primitive schema public name index out of range")

def primitive_schema_row(index):
    if index < 12:
        if index == 0:
            return "1|len|-|1|1|-|value|int|borrow|pure|core|len|2"
        if index == 1:
            return "2|int|-|1|1|-|value|int|borrow|pure|core|int|2"
        if index == 2:
            return "3|str|-|1|1|-|value|string|owned|pure|core|str|2"
        if index == 3:
            return "4|range|-|1|3|-|int,int,int|range|owned|pure|collections|range|4"
        if index == 4:
            return "5|open|-|1|2|-|string,string|file|owned|file|file|file_open|3"
        if index == 5:
            return "6|read_key|-|0|0|-|none|dict|owned|terminal|terminal|terminal_read_key|1"
        if index == 6:
            return "7|ansi_escape|-|0|0|-|none|string|owned|pure|terminal|ansi_escape|1"
        if index == 7:
            return "8|__tyrion_native_wall_time|-|0|0|-|none|float|borrow|clock|clock|wall_time|1"
        if index == 8:
            return "9|__tyrion_native_tcp_connect|-|3|3|-|string,int,int|handle|owned|network|tcp|tcp_connect|4"
        if index == 9:
            return "10|std_io_tcp_connect|__tyrion_native_tcp_connect|3|3|-|string,int,int|handle|owned|network|tcp|tcp_connect|4"
        if index == 10:
            return "11|__tyrion_native_tcp_write|-|3|3|-|handle,bytes,int|int|borrow|network|tcp|tcp_write|4"
        if index == 11:
            return "12|std_io_tcp_write|__tyrion_native_tcp_write|3|3|-|handle,bytes,int|int|borrow|network|tcp|tcp_write|4"
        fail("primitive schema row index out of range")
    else:
        index = index - 12
        if index == 0:
            return "13|__tyrion_native_tcp_read|-|3|3|-|handle,int,int|bytes-or-none|owned|network|tcp|tcp_read|4"
        if index == 1:
            return "14|std_io_tcp_read|__tyrion_native_tcp_read|3|3|-|handle,int,int|bytes-or-none|owned|network|tcp|tcp_read|4"
        if index == 2:
            return "15|__tyrion_native_tcp_close|-|1|1|-|handle|bool|move|network|tcp|tcp_close|2"
        if index == 3:
            return "16|std_io_tcp_close|__tyrion_native_tcp_close|1|1|-|handle|bool|move|network|tcp|tcp_close|2"
        if index == 4:
            return "17|read_text_file|-|1|1|-|string|string|owned|file|compiler-file|read_text_file|2"
        if index == 5:
            return "18|read_module_graph|-|1|1|-|string|string|owned|file|compiler-file|read_module_graph|2"
        if index == 6:
            return "19|write_text_file|-|2|2|-|string,string|bool|borrow|file|compiler-file|write_text_file|2"
        if index == 7:
            return "20|run_tool|-|4|4|-|string,string,string,string|bool|borrow|process|process|run_tool|5"
        if index == 8:
            return "21|asm_writer_open|-|1|1|-|string|writer|owned|file|compiler-writer|writer_open|2"
        if index == 9:
            return "22|asm_writer_append|-|2|2|-|writer,string|writer|retain|file|compiler-writer|writer_append|3"
        if index == 10:
            return "23|asm_writer_close|-|1|1|-|writer|bool|borrow|file|compiler-writer|writer_close|2"
        if index == 11:
            return "24|asm_writer_bytes|-|1|1|-|writer|int|borrow|pure|compiler-writer|writer_bytes|2"
        if index == 12:
            return "25|asm_writer_set_backend|-|2|2|-|writer,string|writer|retain|file|compiler-writer|writer_set_backend|3"
        if index == 13:
            return "26|asm_writer_is_x86|-|1|1|-|writer|bool|borrow|pure|compiler-writer|writer_is_x86|2"
        if index == 14:
            return "27|float|-|1|1|-|value|float|borrow|pure|core|float|2"
        if index == 15:
            return "28|enumerate|-|1|2|start|value,int|list|owned|pure|collections|enumerate|3"
        if index == 16:
            return "29|bool|-|1|1|-|value|bool|borrow|pure|core|bool|2"
        if index == 17:
            return "30|zip|-|1|8|-|value|list|owned|pure|collections|zip|3"
        if index == 18:
            return "31|sum|-|1|2|start|value,value|value|owned|pure|collections|sum|3"
        if index == 19:
            return "32|min|-|1|64|-|value|value|owned|pure|collections|min|2"
        if index == 20:
            return "33|max|-|1|64|-|value|value|owned|pure|collections|max|2"
        if index == 21:
            return "34|any|-|1|1|-|value|bool|borrow|pure|collections|any|2"
        if index == 22:
            return "35|all|-|1|1|-|value|bool|borrow|pure|collections|all|2"
        if index == 23:
            return "36|sorted|-|1|2|key|value,callable|list|owned|pure|collections|sorted|3"
        if index == 24:
            return "37|time|-|0|0|-|none|float|borrow|clock|clock|wall_time|1"
        if index == 25:
            return "38|__tyrion_native_host_load|-|1|1|-|string|handle|owned|extension|host-extension|host_load|2"
        if index == 26:
            return "39|__tyrion_native_host_call|-|3|3|-|handle,string,string|string-or-none|owned|extension|host-extension|host_call|4"
        if index == 27:
            return "40|__tyrion_native_host_unload|-|1|1|-|handle|bool|move|extension|host-extension|host_unload|2"
        fail("primitive schema row index out of range")

def primitive_schema_rows():
    rows = []
    idx = 0
    count = primitive_schema_count()
    while idx < count:
        rows = method_append(rows, primitive_schema_row(idx))
        idx = idx + 1
    return rows

def primitive_schema_text():
    out = ""
    idx = 0
    count = primitive_schema_count()
    while idx < count:
        out = out + primitive_schema_row(idx) + "\n"
        idx = idx + 1
    return out

def primitive_schema_fields(row):
    fields = split_inventory_text(row, "|")
    if len(fields) != 13:
        fail("invalid primitive schema row")
    return fields

def primitive_schema_index_page_0(page_0_name):
    if page_0_name == "len":
        return 0
    if page_0_name == "int":
        return 1
    if page_0_name == "str":
        return 2
    if page_0_name == "range":
        return 3
    if page_0_name == "open":
        return 4
    if page_0_name == "read_key":
        return 5
    if page_0_name == "ansi_escape":
        return 6
    if page_0_name == "__tyrion_native_wall_time":
        return 7
    if page_0_name == "__tyrion_native_tcp_connect":
        return 8
    if page_0_name == "std_io_tcp_connect":
        return 9
    if page_0_name == "__tyrion_native_tcp_write":
        return 10
    if page_0_name == "std_io_tcp_write":
        return 11
    return -1

def primitive_schema_index_page_1(page_1_name):
    if page_1_name == "__tyrion_native_tcp_read":
        return 12
    if page_1_name == "std_io_tcp_read":
        return 13
    if page_1_name == "__tyrion_native_tcp_close":
        return 14
    if page_1_name == "std_io_tcp_close":
        return 15
    if page_1_name == "enumerate":
        return 27
    if page_1_name == "read_text_file":
        return 16
    if page_1_name == "read_module_graph":
        return 17
    if page_1_name == "write_text_file":
        return 18
    if page_1_name == "run_tool":
        return 19
    if page_1_name == "asm_writer_open":
        return 20
    if page_1_name == "asm_writer_append":
        return 21
    if page_1_name == "asm_writer_close":
        return 22
    if page_1_name == "asm_writer_bytes":
        return 23
    if page_1_name == "asm_writer_set_backend":
        return 24
    if page_1_name == "asm_writer_is_x86":
        return 25
    if page_1_name == "float":
        return 26
    if page_1_name == "bool":
        return 28
    if page_1_name == "zip":
        return 29
    if page_1_name == "sum":
        return 30
    if page_1_name == "min":
        return 31
    if page_1_name == "max":
        return 32
    if page_1_name == "any":
        return 33
    if page_1_name == "all":
        return 34
    if page_1_name == "sorted":
        return 35
    if page_1_name == "time":
        return 36
    if page_1_name == "__tyrion_native_host_load":
        return 37
    if page_1_name == "__tyrion_native_host_call":
        return 38
    if page_1_name == "__tyrion_native_host_unload":
        return 39
    return -1

def primitive_schema_index(index_name):
    row_index = primitive_schema_index_page_0(index_name)
    if row_index == -1:
        return primitive_schema_index_page_1(index_name)
    return row_index

def primitive_schema_find(search_name):
    row_index = primitive_schema_index(search_name)
    if row_index == -1:
        return []
    return primitive_schema_fields(primitive_schema_row(row_index))

def primitive_schema_has(has_name):
    return len(primitive_schema_find(has_name)) != 0

def primitive_schema_id(id_name):
    fields = primitive_schema_find(id_name)
    if len(fields) == 0:
        return -1
    return fields[0]

def primitive_schema_symbol(symbol_name):
    fields = primitive_schema_find(symbol_name)
    if len(fields) == 0:
        return ""
    if fields[2] == "-":
        return fields[1]
    return fields[2]

def primitive_schema_capability(capability_name):
    fields = primitive_schema_find(capability_name)
    if len(fields) == 0:
        return ""
    return fields[10]

def primitive_schema_impl_key(implementation_name):
    fields = primitive_schema_find(implementation_name)
    if len(fields) == 0:
        return ""
    return fields[11]

def primitive_schema_accepts_arity(arity_name, argc):
    fields = primitive_schema_find(arity_name)
    if len(fields) == 0:
        return False
    return argc >= fields[3] and argc <= fields[4]

def primitive_schema_runtime_visible(visibility_name):
    fields = primitive_schema_find(visibility_name)
    if len(fields) == 0:
        return False
    capability = fields[10]
    return capability == "core" or capability == "collections" or capability == "file" or capability == "terminal" or capability == "clock" or capability == "tcp" or capability == "host-extension"

def primitive_schema_runtime_operations():
    out = []
    idx = 0
    count = primitive_schema_count()
    while idx < count:
        fields = primitive_schema_fields(primitive_schema_row(idx))
        capability = fields[10]
        if capability == "file" or capability == "terminal" or capability == "clock" or capability == "tcp" or capability == "host-extension":
            out = method_append(out, fields)
        idx = idx + 1
    return out

def primitive_schema_lowered_fixed(fixed_name):
    implementation = primitive_schema_impl_key(fixed_name)
    fixed = ["len", "tcp_connect", "tcp_write", "tcp_read", "tcp_close", "read_text_file", "read_module_graph", "write_text_file", "run_tool", "writer_open", "writer_append", "writer_close", "writer_bytes", "writer_set_backend", "writer_is_x86"]
    idx = 0
    while idx < len(fixed):
        if fixed[idx] == implementation:
            return True
        idx = idx + 1
    return False

def primitive_schema_lowered_side_effect(effect_name):
    fields = primitive_schema_find(effect_name)
    if len(fields) == 0 or not primitive_schema_lowered_fixed(effect_name):
        return False
    return fields[9] != "pure"

def primitive_schema_dispatch_arg_count(dispatch_name):
    fields = primitive_schema_find(dispatch_name)
    if len(fields) == 0:
        return 0
    return fields[12]

def primitive_schema_lowered_plan_kind(plan_name):
    implementation = primitive_schema_impl_key(plan_name)
    if implementation == "len":
        return "native_len_body"
    if implementation == "read_text_file":
        return "native_read_text_file_body"
    if implementation == "read_module_graph":
        return "native_read_module_graph_body"
    if implementation == "write_text_file":
        return "native_write_text_file_body"
    if implementation == "run_tool":
        return "native_run_tool_body"
    if implementation == "tcp_connect" or implementation == "tcp_write" or implementation == "tcp_read" or implementation == "tcp_close":
        return "native_" + implementation + "_body"
    if implementation == "writer_open" or implementation == "writer_append" or implementation == "writer_close" or implementation == "writer_bytes" or implementation == "writer_set_backend" or implementation == "writer_is_x86":
        return "native_asm_" + implementation + "_body"
    return ""

def primitive_schema_require_target(required_name, target):
    capability = primitive_schema_capability(required_name)
    if capability == "":
        fail("unknown primitive: " + required_name)
    if not target_has_capability(target, capability):
        fail("primitive target implementation missing: " + required_name + ":" + target["backend"])
    implementation = primitive_schema_impl_key(required_name)
    if not backend_has_primitive_implementation(target, implementation):
        fail("primitive target implementation missing: " + required_name + ":" + target["backend"])
    return True

def primitive_schema_target_probe(probe_name, os_name, arch):
    target = target_spec(os_name, arch)
    primitive_schema_require_target(probe_name, target)
    return primitive_schema_id(probe_name)

def primitive_schema_manifest():
    return "tyrion-primitive-abi-v1\n" + primitive_schema_text()
