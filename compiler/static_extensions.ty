# Static host-extension planning for direct-native applications.

def static_extension_manifest_scalar(source, key):
    prefix = key + " = \""
    for line in source.split("\n"):
        line = line.strip()
        if line.startswith(prefix) and line.endswith("\""):
            return line[len(prefix):len(line) - 1]
    return ""

def static_extension_manifest_sources(source):
    prefix = "sources = ["
    for line in source.split("\n"):
        line = line.strip()
        if line.startswith(prefix) and line.endswith("]"):
            body = line[len(prefix):len(line) - 1].strip()
            if body == "":
                return []
            sources = []
            for item in body.split(","):
                item = item.strip()
                if len(item) < 2 or not item.startswith("\"") or not item.endswith("\""):
                    fail("invalid static extension sources list")
                value = item[1:len(item) - 1]
                if contains_text(value, "\""):
                    fail("invalid static extension source path: " + value)
                sources = method_append(sources, value)
            return sources
    return []

def static_extension_identifier_valid(value):
    if value == "":
        return False
    idx = 0
    while idx < len(value):
        valid = is_ident_continue(value[idx])
        if valid != True:
            return False
        idx = idx + 1
    return True

def static_extension_append_unique(names, name):
    present = list_contains_string(names, name)
    if present != True:
        names = method_append(names, name)
    return names

def static_extension_expr_names(expr, names):
    kind = expr["kind"]
    if kind == "call":
        if expr["callee"]["kind"] == "var" and expr["callee"]["value"] == "__tyrion_native_host_load":
            if len(expr["args"]) != 1 or expr["args"][0]["kind"] != "string":
                fail("static host load requires one literal extension name")
            names = static_extension_append_unique(names, expr["args"][0]["value"])
        names = static_extension_expr_names(expr["callee"], names)
        for arg in expr["args"]:
            if arg["kind"] == "kwarg":
                names = static_extension_expr_names(arg["value"], names)
            else:
                names = static_extension_expr_names(arg, names)
        return names
    if kind == "method_call":
        names = static_extension_expr_names(expr["receiver"], names)
        for arg in expr["args"]:
            if arg["kind"] == "kwarg":
                names = static_extension_expr_names(arg["value"], names)
            else:
                names = static_extension_expr_names(arg, names)
        return names
    if kind == "binary":
        names = static_extension_expr_names(expr["left"], names)
        return static_extension_expr_names(expr["right"], names)
    if kind == "unary" or kind == "kwarg" or kind == "lambda":
        if kind == "lambda":
            return static_extension_expr_names(expr["body"], names)
        return static_extension_expr_names(expr["value"], names)
    if kind == "index":
        names = static_extension_expr_names(expr["receiver"], names)
        return static_extension_expr_names(expr["index"], names)
    if kind == "slice":
        names = static_extension_expr_names(expr["receiver"], names)
        names = static_extension_expr_names(expr["start"], names)
        return static_extension_expr_names(expr["stop"], names)
    if kind == "attr":
        return static_extension_expr_names(expr["receiver"], names)
    if kind == "list" or kind == "tuple" or kind == "set":
        for item in expr["items"]:
            names = static_extension_expr_names(item, names)
        return names
    if kind == "dict":
        for entry in expr["entries"]:
            names = static_extension_expr_names(entry["key"], names)
            names = static_extension_expr_names(entry["value"], names)
        return names
    if kind == "comprehension":
        names = static_extension_expr_names(expr["iterable"], names)
        names = static_extension_expr_names(expr["condition"], names)
        names = static_extension_expr_names(expr["expr"], names)
        names = static_extension_expr_names(expr["key"], names)
        return static_extension_expr_names(expr["value"], names)
    return names

def static_extension_statement_names(items, names):
    for stmt in items:
        kind = stmt["kind"]
        if kind == "assign":
            names = static_extension_expr_names(stmt["target"], names)
            names = static_extension_expr_names(stmt["value"], names)
        elif kind == "expr" or kind == "return" or kind == "raise" or kind == "yield":
            names = static_extension_expr_names(stmt["value"], names)
        elif kind == "if":
            names = static_extension_expr_names(stmt["condition"], names)
            names = static_extension_statement_names(stmt["body"], names)
            for branch in stmt["elifs"]:
                names = static_extension_expr_names(branch["condition"], names)
                names = static_extension_statement_names(branch["body"], names)
            names = static_extension_statement_names(stmt["else_body"], names)
        elif kind == "while":
            names = static_extension_expr_names(stmt["condition"], names)
            names = static_extension_statement_names(stmt["body"], names)
        elif kind == "for":
            names = static_extension_expr_names(stmt["iterable"], names)
            names = static_extension_statement_names(stmt["body"], names)
        elif kind == "with":
            names = static_extension_expr_names(stmt["resource"], names)
            names = static_extension_statement_names(stmt["body"], names)
        elif kind == "try":
            names = static_extension_statement_names(stmt["body"], names)
            names = static_extension_statement_names(stmt["except_body"], names)
            names = static_extension_statement_names(stmt["finally_body"], names)
        elif kind == "function" or kind == "class":
            names = static_extension_statement_names(stmt["body"], names)
    return names

def static_extension_plan(program, extension_root):
    names = static_extension_statement_names(program["items"], [])
    extensions = []
    for name in names:
        name_valid = static_extension_identifier_valid(name)
        if name_valid != True:
            fail("invalid static extension name: " + name)
        root = extension_root + "/" + name
        manifest_path = root + "/ext.toml"
        manifest = read_text_file(manifest_path)
        manifest_name = static_extension_manifest_scalar(manifest, "name")
        abi = static_extension_manifest_scalar(manifest, "abi")
        call_symbol = static_extension_manifest_scalar(manifest, "call_symbol")
        sources = static_extension_manifest_sources(manifest)
        if manifest_name != name:
            fail("static extension manifest name mismatch: " + name)
        if abi != "tyrion-host-ext/v1":
            fail("unsupported static extension ABI: " + abi)
        symbol_valid = static_extension_identifier_valid(call_symbol)
        if symbol_valid != True:
            fail("invalid static extension call symbol: " + call_symbol)
        if len(sources) == 0:
            fail("static extension requires at least one source: " + name)
        source_paths = []
        for source in sources:
            invalid_source = source == ""
            if not invalid_source:
                invalid_source = source[0] == "/"
            if not invalid_source:
                invalid_source = contains_text(source, "..")
            if invalid_source:
                fail("invalid static extension source path: " + source)
            source_paths = method_append(source_paths, root + "/" + source)
        extensions = method_append(extensions, {"id": len(extensions), "name": name, "call_symbol": call_symbol, "sources": source_paths, "source_count": len(source_paths), "source_path": source_paths[0]})
    return extensions

def static_extension_id(plan, name):
    for extension in plan["extensions"]:
        if extension["name"] == name:
            return extension["id"]
    fail("static extension is not present in the application plan: " + name)
